# ==============================================================================
# Apuni Sarkar (VaaniSetu) - Environment Configuration Template
# ==============================================================================

# Server Port & Mode
PORT=5000
NODE_ENV=development

# ==============================================================================
# ElevenLabs Multi-Account Free-Tier Key Pool (8-9 Accounts)
# Each free ElevenLabs account provides ~10,000 characters (~15 minutes of speech).
# Our KeyPoolManager uses Key 1 first, rotates to Key 2..9 upon reaching limit,
# and NEVER re-uses an exhausted key.
# ==============================================================================

# Option 1: Numbered format (Recommended - cleanest for 8-9 accounts)
ELEVENLABS_API_KEY_1=sk_your_elevenlabs_api_key_1
ELEVENLABS_EMAIL_1=account1@gmail.com

ELEVENLABS_API_KEY_2=sk_your_elevenlabs_api_key_2
ELEVENLABS_EMAIL_2=account2@gmail.com

ELEVENLABS_API_KEY_3=sk_your_elevenlabs_api_key_3
ELEVENLABS_EMAIL_3=account3@gmail.com

ELEVENLABS_API_KEY_4=sk_your_elevenlabs_api_key_4
ELEVENLABS_EMAIL_4=account4@gmail.com

ELEVENLABS_API_KEY_5=sk_your_elevenlabs_api_key_5
ELEVENLABS_EMAIL_5=account5@gmail.com

ELEVENLABS_API_KEY_6=sk_your_elevenlabs_api_key_6
ELEVENLABS_EMAIL_6=account6@gmail.com

ELEVENLABS_API_KEY_7=sk_your_elevenlabs_api_key_7
ELEVENLABS_EMAIL_7=account7@gmail.com

ELEVENLABS_API_KEY_8=sk_your_elevenlabs_api_key_8
ELEVENLABS_EMAIL_8=account8@gmail.com

ELEVENLABS_API_KEY_9=sk_your_elevenlabs_api_key_9
ELEVENLABS_EMAIL_9=account9@gmail.com

# Option 2 (Alternative): Comma-separated list of keys
# ELEVENLABS_API_KEYS="key1,key2,key3,key4,key5,key6,key7,key8,key9"

# ==============================================================================
# ElevenLabs Model & Voice Settings
# ==============================================================================
ELEVENLABS_MODEL_ID="eleven_multilingual_v2"
ELEVENLABS_VOICE_ID="EXAVITQu4vr4xnSDxMaL"

# Threshold for automatic key rotation (default: 9500 chars before 10k limit)
KEY_ROTATION_THRESHOLD_CHARS=9500

# ==============================================================================
# Google Gemini API Key (Intent Routing, Hindi/Pahadi Slot Extraction)
# ==============================================================================
GEMINI_API_KEY=your_gemini_api_key_here

# ==============================================================================
# Automated Email Alerts (Triggered when any key in the pool is exhausted)
# ==============================================================================
ALERT_RECIPIENT_EMAIL="admin@apunisarkar-dev.gov.in"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="alerts@apunisarkar-dev.gov.in"
SMTP_PASS="app_specific_password_here"
