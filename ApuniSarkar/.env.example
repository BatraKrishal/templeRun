# Server Configuration
PORT=5000
NODE_ENV=development

# ElevenLabs Key Pool (Comma-separated list of key:email pairs)
# Format: "key1:email1@domain.com,key2:email2@domain.com,..."
ELEVENLABS_KEYS="sk_free_demo_key_01:uk.citizen.dev1@gmail.com,sk_free_demo_key_02:uk.citizen.dev2@gmail.com,sk_free_demo_key_03:uk.citizen.dev3@gmail.com"

# Default Voice Models
ELEVENLABS_MODEL_ID="eleven_multilingual_v2"
ELEVENLABS_VOICE_ID="21m00Tcm4TlvDq8ikWAM"

# Threshold for automatic key rotation (default: 9500 chars before 10k limit)
KEY_ROTATION_THRESHOLD_CHARS=9500

# Automated Alert Email Settings (Dispatched upon key quota exhaustion)
ALERT_RECIPIENT_EMAIL="admin@apunisarkar-dev.gov.in"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="alerts@apunisarkar-dev.gov.in"
SMTP_PASS="app_specific_password_here"

